{
    "name": "style-eye-theme",
    "displayName": "Style Eye",
    "description": "Style Eyes Creative brand palette on top of the Cyberpunk 2077 rebuild theme",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/aaron-khroma/style-eye.git"
    },
    "publisher": "style-eyes-creative",
    "author": {
        "name": "Style Eyes Creative"
    },
    "license": "MIT",
    "keywords": [
        "style eye",
        "style eyes creative",
        "dark theme"
    ],
    "categories": [
        "Themes"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "package": "npm run build && mkdir -p dist && vsce package --skip-license --out dist/",
        "vsix:install": "npm run package && node scripts/install.mjs"
    },
    "devDependencies": {
        "@vscode/vsce": "4.0.0"
    },
    "contributes": {
        "themes": [
            {
                "label": "Style Eye",
                "uiTheme": "vs-dark",
                "path": "./themes/theme.json"
            }
        ]
    }
}
